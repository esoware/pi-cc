{
  "name": "@esoware/pi-cc-ui",
  "version": "0.3.0",
  "description": "Claude Code style UI for pi",
  "keywords": [
    "pi-extension",
    "pi-package",
    "theme",
    "tui"
  ],
  "homepage": "https://github.com/esoware/pi-cc/tree/main/packages/pi-cc-ui#readme",
  "bugs": {
    "url": "https://github.com/esoware/pi-cc/issues"
  },
  "license": "MIT",
  "author": "Esoware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esoware/pi-cc.git",
    "directory": "packages/pi-cc-ui"
  },
  "files": [
    "extension",
    "theme",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm -w run check && pnpm -w run lint && pnpm -w run format:check"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "themes": [
      "./theme"
    ],
    "image": "https://raw.githubusercontent.com/esoware/pi-cc/main/packages/pi-cc-ui/media/cover.png"
  }
}
